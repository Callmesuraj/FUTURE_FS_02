# MongoDB Atlas connection string (from Atlas dashboard -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/minicrm?retryWrites=true&w=majority

# Any long random string - used to sign login tokens
JWT_SECRET=replace_this_with_a_long_random_string

# Server port (Render will override this automatically)
PORT=5000

# Used only by seedAdmin.js to create your first login
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme123
